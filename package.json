{
	"name": "use-entity",
	"version": "0.1.1",
	"description": "useState-style entity state for React with typed CRUD actions, selectors, and normalized collections.",
	"keywords": [
		"react",
		"state",
		"entity",
		"crud",
		"normalized-state",
		"redux-toolkit",
		"tanstack-store"
	],
	"author": {
		"name": "WookieFPV (Lukas Müller)",
		"url": "https://github.com/WookieFPV"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/WookieFPV/use-entity.git"
	},
	"bugs": {
		"url": "https://github.com/WookieFPV/use-entity/issues"
	},
	"homepage": "https://github.com/WookieFPV/use-entity#readme",
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./tanstack": {
			"import": {
				"types": "./dist/tanstack.d.ts",
				"default": "./dist/tanstack.js"
			},
			"require": {
				"types": "./dist/tanstack.d.cts",
				"default": "./dist/tanstack.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write --unsafe",
		"biome:format": "biome format --write",
		"test": "bun test",
		"build": "tsup",
		"build:dev": "tsup --watch --clean false",
		"typecheck": "tsc",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"prepublishOnly": "bun run biome:check && bun run typecheck && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/cli": "3.0.2",
		"@happy-dom/global-registrator": "20.14.0",
		"@reduxjs/toolkit": "2.12.0",
		"@tanstack/react-store": "0.11.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"lefthook": "2.1.12",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tsup": "8.5.1"
	},
	"overrides": {
		"esbuild": "^0.28.1"
	},
	"peerDependencies": {
		"typescript": "^5",
		"react": ">18.0.0",
		"@reduxjs/toolkit": "^2.0.0",
		"@tanstack/react-store": "0.11.1"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-store": {
			"optional": true
		}
	}
}
